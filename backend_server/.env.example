# Server Port
PORT=3000

# LINE Messaging API Credentials (รับจาก https://developers.line.biz/)
LINE_CHANNEL_ACCESS_TOKEN=YOUR_CHANNEL_ACCESS_TOKEN_HERE
LINE_CHANNEL_SECRET=YOUR_CHANNEL_SECRET_HERE

# LINE User ID ของผู้ดูแลที่ต้องการให้ส่งแจ้งเตือนไปหา (ขึ้นต้นด้วย U...)
CAREGIVER_LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# พิกัด "บ้าน" สำหรับ Geofencing
HOME_LATITUDE=13.756331
HOME_LONGITUDE=100.501765
HOME_RADIUS_METERS=50

# การตั้งค่าช่วงเวลาแจ้งเตือน (วินาที)
INTERVAL_STATIONARY_SEC=7200 # 2 ชั่วโมง
INTERVAL_MOVING_SEC=120      # 2 นาที
INTERVAL_OUTSIDE_SEC=30      # 30 วินาที

